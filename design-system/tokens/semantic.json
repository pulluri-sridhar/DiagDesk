{
  "$description": "Semantic (role) tokens — what UI consumes. Aliases to core primitives + brand tokens. Defined for light and dark; brand files override the brand.* hues. Names align to shadcn/ui CSS variables so shadcn components theme with zero extra config.",
  "color": {
    "$type": "color",
    "light": {
      "background":        {"$value": "{color.slate.25}"},
      "foreground":        {"$value": "{color.slate.900}"},
      "card":              {"$value": "{color.slate.0}"},
      "card-foreground":   {"$value": "{color.slate.900}"},
      "popover":           {"$value": "{color.slate.0}"},
      "popover-foreground":{"$value": "{color.slate.900}"},
      "muted":             {"$value": "{color.slate.50}"},
      "muted-foreground":  {"$value": "{color.slate.600}"},
      "border":            {"$value": "{color.slate.200}"},
      "input":             {"$value": "{color.slate.200}"},
      "primary":           {"$value": "{brand.primary}"},
      "primary-foreground":{"$value": "{brand.primary-foreground}"},
      "secondary":         {"$value": "{brand.secondary}"},
      "secondary-foreground":{"$value": "{brand.secondary-foreground}"},
      "accent":            {"$value": "{brand.accent}"},
      "accent-foreground": {"$value": "{brand.accent-foreground}"},
      "ring":              {"$value": "{brand.primary}"},
      "success":           {"$value": "{color.green.default}"},
      "success-foreground":{"$value": "{color.slate.0}"},
      "warning":           {"$value": "{color.amber.default}"},
      "warning-foreground":{"$value": "{color.slate.0}"},
      "danger":            {"$value": "{color.red.default}"},
      "danger-foreground": {"$value": "{color.slate.0}"}
    },
    "dark": {
      "background":        {"$value": "{color.darksurface.bg}"},
      "foreground":        {"$value": "{color.darksurface.fg}"},
      "card":              {"$value": "{color.darksurface.card}"},
      "card-foreground":   {"$value": "{color.darksurface.fg}"},
      "popover":           {"$value": "{color.darksurface.card}"},
      "popover-foreground":{"$value": "{color.darksurface.fg}"},
      "muted":             {"$value": "{color.darksurface.muted}"},
      "muted-foreground":  {"$value": "{color.darksurface.fg-muted}"},
      "border":            {"$value": "{color.darksurface.border}"},
      "input":             {"$value": "{color.darksurface.border}"},
      "primary":           {"$value": "{brand.primary-dark}"},
      "primary-foreground":{"$value": "{brand.primary-foreground}"},
      "secondary":         {"$value": "{brand.secondary-dark}"},
      "secondary-foreground":{"$value": "{brand.secondary-foreground}"},
      "accent":            {"$value": "{brand.accent-dark}"},
      "accent-foreground": {"$value": "{brand.accent-foreground}"},
      "ring":              {"$value": "{brand.primary-dark}"},
      "success":           {"$value": "#34a877"},
      "success-foreground":{"$value": "{color.slate.950}"},
      "warning":           {"$value": "#d98a2b"},
      "warning-foreground":{"$value": "{color.slate.950}"},
      "danger":            {"$value": "#ff6b6b"},
      "danger-foreground": {"$value": "{color.slate.950}"}
    }
  },
  "radius": { "$type": "dimension", "DEFAULT": {"$value": "{radius.md}"} },
  "font": { "family": { "sans": {"$value": "{font.family.sans}"}, "icon": {"$value": "{font.family.icon}"} } }
}
