FROM maven:3.9.9-eclipse-temurin-21-alpine AS builder
WORKDIR /workspace
COPY backend/ .
RUN mvn -N install -DskipTests -B -q && \
    mvn -pl common-lib install -DskipTests -B -q && \
    mvn -pl patient-service clean package spring-boot:repackage -DskipTests -B -q

FROM eclipse-temurin:21-jre-alpine AS runtime
WORKDIR /app
RUN addgroup -S diagdesk && adduser -S diagdesk -G diagdesk
COPY --from=builder /workspace/patient-service/target/*.jar app.jar
EXPOSE 8080
USER diagdesk
ENTRYPOINT ["java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "-Djava.security.egd=file:/dev/./urandom", "-jar", "app.jar"]
