%% MediCircle — core ERD (~55 tables). Reconciled: integer paise, UUIDv7, RLS,
%% transactional outbox, DPDP/ABDM/FHIR. NO commission or referral-payout tables.
%% The only money-to-a-professional path is PROFESSIONAL_SERVICE_CONTRACTS
%% (basis fixed or per_service) settled via SERVICE_ENGAGEMENTS.
erDiagram

  %% ---- Identity and access ----
  USERS {
    uuid id PK
    text phone
    text email
    enum primary_role
    enum status
  }
  ROLES {
    uuid id PK
    enum name
  }
  PERMISSIONS {
    uuid id PK
    text code
  }
  ROLE_PERMISSION {
    uuid role_id FK
    uuid permission_id FK
  }
  USER_PERMISSION {
    uuid user_id FK
    uuid permission_id FK
    enum effect
  }
  USER_ROLES {
    uuid user_id FK
    enum role
    uuid org_id
  }
  SESSIONS {
    uuid id PK
    uuid user_id FK
    ts expires_at
  }
  KYC_DOCUMENTS {
    uuid id PK
    uuid owner_user_id FK
    enum status
  }
  CREDENTIALS {
    uuid id PK
    uuid owner_user_id FK
    text credential_type
    enum status
  }

