  TENANT {
    uuid id PK
    text name
    text region "India"
    timestamptz created_at
  }
  BRANCH {
    uuid id PK
    uuid tenant_id FK
    text name
    text type "collection/hub"
  }
  APP_USER {
    uuid id PK
    uuid tenant_id FK
    text email
    text phone
    text user_type "non_financial/financial/admin/owner"
    int view_financial_reports_days
    numeric discount_limit_pct
    text status
  }
  ROLE {
    uuid id PK
    uuid tenant_id FK
    text name
    jsonb permissions "baseline"
  }
  USER_ROLE {
    uuid user_id FK
    uuid role_id FK
    uuid branch_id FK
  }
  PERMISSION {
    text key PK
    text label
    text category
    text value_type "bool/int/text"
  }
  ROLE_PERMISSION {
    uuid role_id FK
    text permission_key FK
    text value "nullable"
  }
  USER_PERMISSION {
    uuid user_id FK
    text permission_key FK
    text effect "grant/revoke"
    text value "nullable"
  }
  PATIENT {
    uuid id PK
    uuid tenant_id FK
    text mpi_no
    text name
    int age
    text sex
    text phone
    text abha "nullable"
  }
  REFERRING_DOCTOR {
    uuid id PK
    uuid tenant_id FK
    text name
    text speciality
    text phone
    text note "referral SOURCE only - NO payout/commission fields"
  }
  B2B_PARTNER {
    uuid id PK
    uuid tenant_id FK
    text name
    text type "hospital/clinic/corporate/TPA/ref-lab"
    text gstin
  }
  B2B_ACCOUNT {
    uuid id PK
    uuid partner_id FK
    uuid rate_card_id FK
    numeric credit_limit
    int billing_cycle_days
  }
  PROFESSIONAL_SERVICE_CONTRACT {
    uuid id PK
    uuid tenant_id FK
    text party_name
    text service_type "reporting/consulting/teleradiology"
    text basis "fixed/per_service - NEVER per_referral"
    numeric rate
    boolean is_also_referrer "true = flagged for review"
  }
  SERVICE_ENGAGEMENT {
    uuid id PK
    uuid contract_id FK
    text service_ref "report/study performed - not a referred patient"
    numeric amount
    timestamptz at
  }
  DEPARTMENT {
    uuid id PK
    uuid tenant_id FK
    text name
    text code
  }
  NABL_TEST_CATALOG {
    uuid id PK
    text code
    text name
    text department
    text loinc "nullable"
    jsonb default_ranges
  }
  TEST {
    uuid id PK
    uuid tenant_id FK
    text code
    text name
    uuid department_id FK
    uuid specimen_type_id FK
    boolean is_custom "non-NABL"
    uuid nabl_ref FK "nullable"
    int tat_hours
  }
  TEST_PANEL {
    uuid id PK
    uuid tenant_id FK
    text name
  }
  PANEL_ITEM {
    uuid panel_id FK
    uuid test_id FK
  }
  HEALTH_PACKAGE {
    uuid id PK
    uuid tenant_id FK
    text name
    numeric price
    boolean active
  }
  HEALTH_PACKAGE_ITEM {
    uuid package_id FK
    uuid test_id FK
  }
  REFERENCE_RANGE {
    uuid id PK
    uuid test_id FK
    text sex
    int age_min
    int age_max
    numeric low
    numeric high
    numeric critical_low
    numeric critical_high
  }
  RATE_CARD {
    uuid id PK
    uuid tenant_id FK
    text name
    text scheme "default/CGHS/ECHS/TPA/B2B"
    uuid branch_id FK
  }
  RATE_CARD_ITEM {
    uuid rate_card_id FK
    uuid test_id FK
    numeric price
  }
  ORDER {
    uuid id PK
    uuid tenant_id FK
    uuid branch_id FK
    uuid patient_id FK
    uuid referring_doctor_id FK "source - nullable"
    uuid b2b_partner_id FK "nullable"
    text status
    timestamptz ordered_at
  }
  ORDER_ITEM {
    uuid id PK
    uuid order_id FK
    uuid test_id FK
    numeric price
    text status
  }
  SAMPLE {
    uuid id PK
    uuid order_id FK
    text barcode
    uuid container_id FK
    text status
  }
  SAMPLE_EVENT {
    uuid id PK
    uuid sample_id FK
    text event "collected/received/in_process/rejected"
    text reason_code
    timestamptz at
  }
  RESULT {
    uuid id PK
    uuid order_item_id FK
    text status
    text source "analyzer/manual"
  }
  RESULT_VALUE {
    uuid id PK
    uuid result_id FK
    text analyte
    numeric value
    text unit
    text flag "H/L/critical"
  }
  VALIDATION {
    uuid id PK
    uuid result_id FK
    uuid validated_by FK
    text level "tech/pathologist"
    timestamptz at
  }
  REPORT_STATIONERY {
    uuid id PK
    uuid tenant_id FK
    uuid branch_id FK "nullable"
    text header_html
    text footer_html
    text logo_uri
    jsonb margins
  }
  REPORT_TEMPLATE {
    uuid id PK
    uuid tenant_id FK
    text name
    uuid department_id FK
    uuid stationery_id FK
    jsonb layout
  }
  REPORT {
    uuid id PK
    uuid order_id FK
    uuid template_id FK
    text state "draft/in_review/preliminary/final"
    uuid reviewed_by FK "nullable"
    uuid signed_by FK "nullable"
    text pdf_uri
    int print_count
    text handover_status "pending/handed_over"
  }
  REPORT_DELIVERY {
    uuid id PK
    uuid report_id FK
    text channel "whatsapp/sms/email"
    uuid initiated_by FK "manual send"
    text status
    timestamptz at
  }
  REPORT_PRINT_LOG {
    uuid id PK
    uuid report_id FK
    uuid printed_by FK
    int copies
    timestamptz at
  }
  REPORT_HANDOVER {
    uuid id PK
    uuid report_id FK
    text handed_to
    text method "barcode/manual"
    text scanned_barcode "nullable"
    uuid by_user FK
    timestamptz at
  }
  INVOICE {
    uuid id PK
    uuid tenant_id FK
    uuid order_id FK
    numeric subtotal
    numeric discount
    text discount_justification "mandatory if discount"
    uuid discount_approved_by FK "nullable"
    numeric gst
    numeric total
    numeric due
    text payer_type "b2c/b2b"
  }
  INVOICE_LINE {
    uuid id PK
    uuid invoice_id FK
    uuid test_id FK
    numeric price
    numeric gst_rate
  }
  PAYMENT {
    uuid id PK
    uuid invoice_id FK
    text mode "cash/upi/card/partial"
    numeric amount
    timestamptz at
  }
  B2B_RECEIVABLE {
    uuid id PK
    uuid b2b_account_id FK
    uuid invoice_id FK
    numeric amount
    int days_overdue
    text status
  }
  INVENTORY_ITEM {
    uuid id PK
    uuid tenant_id FK
    uuid branch_id FK
    text name
    text unit
    numeric qty_on_hand
    numeric reorder_threshold "low-stock alert"
    text batch_no
    date expiry
  }
  TEST_KIT {
    uuid id PK
    uuid tenant_id FK
    uuid inventory_item_id FK
    text name
    int tests_per_kit "kit size eg 10/100"
    int tests_remaining
    text lot_no
    date expiry
  }
  STOCK_LEDGER {
    uuid id PK
    uuid inventory_item_id FK
    text txn "receipt/issue/consumption/adjust"
    numeric qty
    text ref "test/order on consumption"
    timestamptz at
  }
  EXPENSE_CATEGORY {
    uuid id PK
    uuid tenant_id FK
    text name "rent/salaries/utilities/reagents/..."
  }
  EXPENSE {
    uuid id PK
    uuid tenant_id FK
    uuid branch_id FK
    uuid category_id FK
    numeric amount
    text mode "cash/upi/bank"
    text payee
    timestamptz incurred_at
  }
  CONSENT {
    uuid id PK
    uuid tenant_id FK
    uuid patient_id FK
    text purpose
    text status
    timestamptz at
  }
  AUDIT_LOG {
    uuid id PK
    uuid tenant_id FK
    text entity
    text action
    uuid actor_id
    text prev_hash
    text hash
    timestamptz at
  }
