erDiagram
  TENANT ||--o{ BRANCH : has
  TENANT ||--o{ APP_USER : has
  APP_USER ||--o{ USER_ROLE : assigned
  ROLE ||--o{ USER_ROLE : grants
  TENANT ||--o{ PATIENT : registers
  TENANT ||--o{ REFERRING_DOCTOR : tracks
  TENANT ||--o{ B2B_PARTNER : contracts
  B2B_PARTNER ||--|| B2B_ACCOUNT : has
  TENANT ||--o{ TEST : defines
  TEST_PANEL ||--o{ PANEL_ITEM : contains
  TEST ||--o{ PANEL_ITEM : in
  TEST ||--o{ REFERENCE_RANGE : has
  RATE_CARD ||--o{ RATE_CARD_ITEM : has
  TEST ||--o{ RATE_CARD_ITEM : priced
  PATIENT ||--o{ ORDER : places
  BRANCH ||--o{ ORDER : at
  REFERRING_DOCTOR ||--o{ ORDER : source_of
  B2B_PARTNER ||--o{ ORDER : for
  ORDER ||--o{ ORDER_ITEM : contains
  TEST ||--o{ ORDER_ITEM : of
  ORDER ||--o{ SAMPLE : yields
  SAMPLE ||--o{ SAMPLE_EVENT : lifecycle
  ORDER_ITEM ||--o{ RESULT : produces
  RESULT ||--o{ RESULT_VALUE : has
  RESULT ||--o{ VALIDATION : reviewed_by
  ORDER ||--o{ REPORT : generates
  REPORT ||--o{ REPORT_DELIVERY : delivered_via
  ORDER ||--|| INVOICE : billed_by
  INVOICE ||--o{ INVOICE_LINE : has
  INVOICE ||--o{ PAYMENT : settled_by
  B2B_ACCOUNT ||--o{ B2B_RECEIVABLE : owes
  INVOICE ||--o{ B2B_RECEIVABLE : on
  PATIENT ||--o{ CONSENT : grants

  TENANT {
    uuid id PK
    text name
    text region "India"
    timestamptz created_at
  }
  BRANCH {
    uuid id PK
    uuid tenant_id FK
    text name
    text type "collection/hub"
  }
  APP_USER {
    uuid id PK
    uuid tenant_id FK
    text email
    text phone
    text status
  }
  ROLE {
    uuid id PK
    uuid tenant_id FK
    text name
    jsonb permissions
  }
  USER_ROLE {
    uuid user_id FK
    uuid role_id FK
    uuid branch_id FK
  }
  PATIENT {
    uuid id PK
    uuid tenant_id FK
    text mpi_no
    text name
    int age
    text sex
    text phone
    text abha "nullable"
  }
  REFERRING_DOCTOR {
    uuid id PK
    uuid tenant_id FK
    text name
    text speciality
    text phone
    text note "referral SOURCE only - NO payout/commission fields"
  }
  B2B_PARTNER {
    uuid id PK
    uuid tenant_id FK
    text name
    text type "hospital/clinic/corporate/TPA/ref-lab"
    text gstin
  }
  B2B_ACCOUNT {
    uuid id PK
    uuid partner_id FK
    uuid rate_card_id FK
    numeric credit_limit
    int billing_cycle_days
  }
  TEST {
    uuid id PK
    uuid tenant_id FK
    text code
    text name
    text department
    uuid specimen_type_id FK
    int tat_hours
  }
  TEST_PANEL {
    uuid id PK
    uuid tenant_id FK
    text name
  }
  PANEL_ITEM {
    uuid panel_id FK
    uuid test_id FK
  }
  REFERENCE_RANGE {
    uuid id PK
    uuid test_id FK
    text sex
    int age_min
    int age_max
    numeric low
    numeric high
    numeric critical_low
    numeric critical_high
  }
  RATE_CARD {
    uuid id PK
    uuid tenant_id FK
    text name
    text scheme "default/CGHS/ECHS/TPA/B2B"
    uuid branch_id FK
  }
  RATE_CARD_ITEM {
    uuid rate_card_id FK
    uuid test_id FK
    numeric price
  }
  ORDER {
    uuid id PK
    uuid tenant_id FK
    uuid branch_id FK
    uuid patient_id FK
    uuid referring_doctor_id FK "source - nullable"
    uuid b2b_partner_id FK "nullable"
    text status
    timestamptz ordered_at
  }
  ORDER_ITEM {
    uuid id PK
    uuid order_id FK
    uuid test_id FK
    numeric price
    text status
  }
  SAMPLE {
    uuid id PK
    uuid order_id FK
    text barcode
    uuid container_id FK
    text status
  }
  SAMPLE_EVENT {
    uuid id PK
    uuid sample_id FK
    text event "collected/received/in_process/rejected"
    text reason_code
    timestamptz at
  }
  RESULT {
    uuid id PK
    uuid order_item_id FK
    text status
    text source "analyzer/manual"
  }
  RESULT_VALUE {
    uuid id PK
    uuid result_id FK
    text analyte
    numeric value
    text unit
    text flag "H/L/critical"
  }
  VALIDATION {
    uuid id PK
    uuid result_id FK
    uuid validated_by FK
    text level "tech/pathologist"
    timestamptz at
  }
  REPORT {
    uuid id PK
    uuid order_id FK
    text state "preliminary/final"
    text pdf_uri
    text signature
  }
  REPORT_DELIVERY {
    uuid id PK
    uuid report_id FK
    text channel "whatsapp/sms/email"
    text status
    timestamptz at
  }
  INVOICE {
    uuid id PK
    uuid tenant_id FK
    uuid order_id FK
    numeric subtotal
    numeric discount
    numeric gst
    numeric total
    numeric due
    text payer_type "b2c/b2b"
  }
  INVOICE_LINE {
    uuid id PK
    uuid invoice_id FK
    uuid test_id FK
    numeric price
    numeric gst_rate
  }
  PAYMENT {
    uuid id PK
    uuid invoice_id FK
    text mode "cash/upi/card/partial"
    numeric amount
    timestamptz at
  }
  B2B_RECEIVABLE {
    uuid id PK
    uuid b2b_account_id FK
    uuid invoice_id FK
    numeric amount
    int days_overdue
    text status
  }
  CONSENT {
    uuid id PK
    uuid tenant_id FK
    uuid patient_id FK
    text purpose
    text status
    timestamptz at
  }
  AUDIT_LOG {
    uuid id PK
    uuid tenant_id FK
    text entity
    text action
    uuid actor_id
    text prev_hash
    text hash
    timestamptz at
  }
